{
  "name": "recipe-finder",
  "productName": "Recipe Finder",
  "version": "1.0.0",
  "description": "Find recipes based on the ingredients you have. Filter by dietary preference, meal type, cooking time, and difficulty.",
  "main": "main.js",
  "author": "Solo Apps Studio <soloappsstudio26@gmail.com>",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --universal --x64 --arm64",
    "dist:win": "electron-builder --win --x64 --arm64",
    "dist:linux": "electron-builder --linux AppImage --x64 --arm64",
    "dist:all": "npm run dist:mac && npm run dist:win && npm run dist:linux",
    "android:prepare": "mkdir -p www && cp index.html www/ && npx cap sync android",
    "android:debug": "npm run android:prepare && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:prepare && cd android && ./gradlew assembleRelease",
    "ios:prepare": "mkdir -p www && cp index.html www/ && npx cap sync ios"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.soloappsstudio.recipefinder",
    "productName": "Recipe Finder",
    "copyright": "Copyright © 2026 Solo Apps Studio",
    "publish": null,
    "afterSign": "build/afterSign.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "index.html"
    ],
    "mac": {
      "category": "public.app-category.food-and-drink",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal",
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal",
            "x64",
            "arm64"
          ]
        }
      ],
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "appx": {
      "identityName": "SoloAppsStudio.RecipeFinder",
      "publisher": "CN=AB578A7A-AB77-4581-85A4-109FDE76C7BE",
      "publisherDisplayName": "Solo Apps Studio",
      "applicationId": "RecipeFinder",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Food",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "keywords": [],
  "type": "commonjs"
}
